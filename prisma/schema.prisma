generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id           String   @id @default(cuid())
  balance      Float    @default(10000.0)
  currency     String   @default("USD")
  totalProfit  Float    @default(0.0)
  totalLoss    Float    @default(0.0)
  winRate      Float    @default(0.0)
  totalTrades  Int      @default(0)
  winningTrades Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Trade {
  id          String   @id @default(cuid())
  pair        String
  direction   String   // "buy" or "sell"
  amount      Float
  entryPrice  Float
  exitPrice   Float?
  profitLoss  Float?
  status      String   @default("open") // "open", "closed", "auto"
  strategy    String?
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Strategy {
  id            String   @id @default(cuid())
  name          String
  type          String   // "ma_cross", "rsi", "macd", "scalping", "trend_follow"
  active        Boolean  @default(false)
  pair          String   @default("EUR/USD")
  timeframe     String   @default("1m")
  takeProfit    Float    @default(50.0)
  stopLoss      Float    @default(25.0)
  maxTrades     Int      @default(5)
  amountPerTrade Float   @default(100.0)
  params        String   @default("{}") // JSON string for strategy-specific params
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AutoBotConfig {
  id             String   @id @default(cuid())
  enabled        Boolean  @default(false)
  maxConcurrentTrades Int  @default(3)
  maxDailyLoss   Float    @default(500.0)
  maxDailyProfit Float    @default(1000.0)
  riskPerTrade   Float    @default(2.0) // percentage
  trailingStop   Boolean  @default(false)
  trailingStopPct Float   @default(1.5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============ Protection Fund System ============

// Subscriber accounts with protection plans
model Subscriber {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  plan            String   @default("free") // "free", "bronze", "silver", "gold"
  planPrice       Float    @default(0.0)    // monthly price
  protectionPct   Float    @default(0.0)    // % of loss protected
  protectionLimit Float    @default(0.0)    // max protection per month
  fundBalance     Float    @default(0.0)    // current protection fund balance
  fundUsed        Float    @default(0.0)    // how much used this month
  fundResetAt     DateTime @default(now())  // when fund resets (monthly)
  totalTrades     Int      @default(0)
  winningTrades   Int      @default(0)
  totalVolume     Float    @default(0.0)    // total trading volume
  milestone       Int      @default(1)      // current milestone level (1-4)
  isActive        Boolean  @default(true)
  subscribedAt    DateTime @default(now())
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  rewardBoxes     RewardBox[]
  transactions    FundTransaction[]
  claims          ProtectionClaim[]
}

// Reward boxes that unlock with trading activity
model RewardBox {
  id            String   @id @default(cuid())
  subscriberId  String
  subscriber    Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  boxType       String   @default("standard") // "standard", "premium", "vip"
  status        String   @default("locked")   // "locked", "available", "opened", "expired"
  requiredTrades Int     @default(5)          // trades needed to unlock
  bonusAmount   Float    @default(0.0)        // bonus $ amount
  bonusPct      Float    @default(0.0)        // extra protection %
  freeTrades    Int      @default(0)          // free trades included
  unlockedAt    DateTime?
  openedAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Fund transactions (deposits, claims, rewards)
model FundTransaction {
  id            String   @id @default(cuid())
  subscriberId  String
  subscriber    Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  type          String   // "subscription", "protection_claim", "reward_bonus", "milestone_bonus", "fund_deposit", "fund_reset"
  amount        Float
  balance       Float    // balance after transaction
  description   String?
  tradeId       String?  // related trade ID (for claims)
  createdAt     DateTime @default(now())
}

// Protection claims when trades lose
model ProtectionClaim {
  id            String   @id @default(cuid())
  subscriberId  String
  subscriber    Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tradeId       String?
  tradePair     String
  tradeAmount   Float    // original trade amount
  tradeLoss     Float    // actual loss
  claimPct      Float    // protection % applied
  claimAmount   Float    // amount reimbursed
  status        String   @default("approved") // "pending", "approved", "rejected"
  createdAt     DateTime @default(now())
}

// ============ Activation Codes System ============
// One-time use codes - each valid for 1 month, tied to one device
model ActivationCode {
  id              String    @id @default(cuid())
  code            String    @unique        // ALFA-XXXX-XXXX format
  status          String    @default("unused") // "unused", "used", "expired", "revoked"
  usedBy          String?                  // email of user who used it
  deviceId        String?                  // device fingerprint (one device per code)
  deviceInfo      String?                  // human-readable device info
  activatedAt     DateTime?                // when first used
  expiresAt       DateTime?                // 30 days after activation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  notes           String?                  // admin notes
}
